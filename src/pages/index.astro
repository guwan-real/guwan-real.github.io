---
import heroWorkbench from "../assets/hero-workbench.png";
import "../styles/global.css";

const profile = {
  initials: "FT",
  name: "付涛",
  role: "Agent Infra / Development / Learning",
  location: "合肥, 中国",
  headline: "我关注 Agent Infra 和开发，把学习、实验和工程实践整理成可以持续复用的系统。",
  current: "目前围绕 Agent Infra、开发实践和个人学习体系做持续积累。",
};

const signals = [
  ["Focus", "Agent Infra, developer tools, applied engineering"],
  ["Mode", "Learning notes, prototypes, engineering practice"],
  ["Stack", "TypeScript, Python, Hugo, Astro"],
  ["Base", "Hefei, China"],
];

const education = [
  {
    period: "2018.09 - 2022.06",
    school: "武汉大学",
    institute: "计算机学院",
    note: "本科阶段",
  },
  {
    period: "2024.09 - 2027.06",
    school: "中国科学技术大学",
    institute: "先进技术研究院",
    note: "研究生阶段",
  },
];

const projects = [
  {
    type: "Featured",
    title: "Learning Diary",
    description: "一个 Hugo 驱动的学习日记，用来沉淀笔记、面试整理和技术思考。",
    href: "/learning-diary/",
  },
  {
    type: "Project",
    title: "Project Name",
    description: "Short description for a product, research prototype, or open-source repository.",
    href: "#contact",
  },
  {
    type: "Lab",
    title: "Experiment Name",
    description: "A compact place to describe a live demo, dataset, model, tool, or study.",
    href: "#contact",
  },
];

const writings = [
  {
    title: "Learning Diary",
    description: "学习笔记、长文技术整理和面试复盘。",
    href: "/learning-diary/",
    featured: true,
  },
  {
    title: "Essay Title",
    description: "A future essay about systems, craft, or a hard-won lesson.",
    href: "#",
  },
  {
    title: "Field Note",
    description: "A short observation from building and studying.",
    href: "#",
  },
];

const timeline = [
  ["Now", "Agent Infra and development", "持续学习 agent 基础设施、开发工具与工程实践。"],
  ["Next", "Fill selected projects", "把项目卡片替换成真实仓库、实验或作品。"],
  ["Later", "Add richer case studies", "将重要项目扩展成更完整的 case study 页面。"],
];

const contact = [
  ["GitHub", "guwan-real", "https://github.com/guwan-real"],
  ["Email", "name@example.com", "mailto:name@example.com"],
  ["Writing", "Learning Diary", "/learning-diary/"],
  ["Elsewhere", "@handle", "#"],
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={profile.headline} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={`${profile.name} - Personal Homepage`} />
    <meta property="og:description" content={profile.headline} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://guwan-real.github.io/" />
    <title>{profile.name} - Personal Homepage</title>
  </head>
  <body>
    <header class="site-header shell">
      <a class="brand" href="/" aria-label="Home">
        <span class="brand-mark">{profile.initials}</span>
        <span>{profile.name}</span>
      </a>
      <nav class="nav" aria-label="Primary navigation">
        <a href="#about">About</a>
        <a href="#education">Education</a>
        <a href="#work">Work</a>
        <a href="#writing">Writing</a>
        <a href="/appendix/cs-review/">Appendix / CS Review</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main class="shell">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">{profile.role} / {profile.location}</p>
          <h1 id="hero-title">{profile.name}</h1>
          <p>{profile.headline}</p>
          <div class="hero-actions">
            <a class="button primary" href="#work">View Work</a>
            <a class="button" href="/learning-diary/">Learning Diary</a>
          </div>
        </div>
        <div class="hero-media">
          <div class="image-frame">
            <img src={heroWorkbench.src} width={heroWorkbench.width} height={heroWorkbench.height} alt="A quiet workbench with notes, screens, and an abstract knowledge map" />
          </div>
          <div class="status-card" aria-label="Current focus">
            <span>Current</span>
            <strong>{profile.current}</strong>
          </div>
        </div>
      </section>

      <section class="section" id="about" aria-labelledby="about-title">
        <div class="section-head">
          <div>
            <p class="eyebrow">About</p>
            <h2 id="about-title">Agent Infra, development, and durable learning.</h2>
          </div>
          <p>这里先保留为一个简洁的个人主页入口，后续可以继续补充更具体的研究兴趣、项目经历、论文或实习信息。</p>
        </div>
        <div class="about-grid">
          <div class="panel">
            <p>
              我目前主要关注 Agent Infra 和开发方向，希望把学习过程、工程实践和阶段性项目都整理成可追踪、可复盘、可继续迭代的材料。
            </p>
          </div>
          <div class="panel">
            <ul class="signal-list">
              {signals.map(([label, value]) => (
                <li><b>{label}</b><span>{value}</span></li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section class="section" id="education" aria-labelledby="education-title">
        <div class="section-head">
          <div>
            <p class="eyebrow">Education</p>
            <h2 id="education-title">Academic path.</h2>
          </div>
          <p>教育经历先按时间线保留为简洁版本，后续可以继续补充课程、研究方向、导师、论文或项目。</p>
        </div>
        <div class="education-grid">
          {education.map((item) => (
            <article class="education-card">
              <span class="card-kicker">{item.period}</span>
              <h3>{item.school}</h3>
              <p>{item.institute}</p>
              <strong>{item.note}</strong>
            </article>
          ))}
        </div>
      </section>

      <section class="section" id="work" aria-labelledby="work-title">
        <div class="section-head">
          <div>
            <p class="eyebrow">Selected Work</p>
            <h2 id="work-title">Things worth pointing at.</h2>
          </div>
          <p>Keep this list short. Three strong entries usually feel more intentional than a long shelf of everything.</p>
        </div>
        <div class="project-grid">
          {projects.map((project) => (
            <article class="project-card">
              <span class="card-kicker">{project.type}</span>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <a class="card-link" href={project.href}>Open -&gt;</a>
            </article>
          ))}
        </div>
      </section>

      <section class="section" id="writing" aria-labelledby="writing-title">
        <div class="section-head">
          <div>
            <p class="eyebrow">Writing</p>
            <h2 id="writing-title">Notes that keep their shape.</h2>
          </div>
          <p>Writing can be essays, logs, technical notes, or public study material. Start with links, then grow into pages later.</p>
        </div>
        <div class="writing-grid">
          <article class="writing-card featured">
            <span class="card-kicker">Archive</span>
            <h3>{writings[0].title}</h3>
            <p>{writings[0].description}</p>
            <a class="card-link" href={writings[0].href}>Read -&gt;</a>
          </article>
          <div class="writing-stack">
            {writings.slice(1).map((item) => (
              <article class="writing-card">
                <span class="card-kicker">Draft</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <a class="card-link" href={item.href}>Open -&gt;</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="timeline-title">
        <div class="section-head">
          <div>
            <p class="eyebrow">Timeline</p>
            <h2 id="timeline-title">A small map of what changes next.</h2>
          </div>
          <p>These entries can become recent milestones, current goals, or a lightweight now page.</p>
        </div>
        <ol class="timeline">
          {timeline.map(([when, title, description]) => (
            <li>
              <time>{when}</time>
              <div>
                <strong>{title}</strong>
                <span>{description}</span>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="section" id="contact" aria-labelledby="contact-title">
        <div class="section-head">
          <div>
            <p class="eyebrow">Contact</p>
            <h2 id="contact-title">A few doors left open.</h2>
          </div>
          <p>Swap these links for your real GitHub, email, blog, resume, or social profiles whenever you are ready.</p>
        </div>
        <div class="contact-grid">
          {contact.map(([label, value, href]) => (
            <a class="contact-card" href={href}>
              <span class="card-kicker">{label}</span>
              <h3>{value}</h3>
            </a>
          ))}
        </div>
      </section>
    </main>

    <footer class="site-footer shell">
      <span>&copy; {new Date().getFullYear()} {profile.name}</span>
      <span>Built with Astro</span>
    </footer>
  </body>
</html>
